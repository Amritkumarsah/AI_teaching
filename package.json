{
  "name": "ai-teacher-platform",
  "version": "1.0.0",
  "description": "Production-Ready AI Teacher Platform — Adaptive Multimodal Educational System",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/api run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "ai-teacher",
    "education",
    "rag",
    "tts",
    "viseme",
    "adaptive-learning"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001810"
  }
}
